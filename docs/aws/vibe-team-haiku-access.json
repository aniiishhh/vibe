{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TestRequestedHaikuProfile",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": "arn:aws:bedrock:us-east-2:851725603471:inference-profile/us.anthropic.claude-haiku-4-5-20251001-v1:0"
    },
    {
      "Sid": "TestHaikuThroughRequestedProfileOnly",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": [
        "arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:us-east-2::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0"
      ],
      "Condition": { "StringEquals": { "bedrock:InferenceProfileArn": "arn:aws:bedrock:us-east-2:851725603471:inference-profile/us.anthropic.claude-haiku-4-5-20251001-v1:0" } }
    },
    {
      "Sid": "ProvisionProjectTinyFishParameter",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:PutParameter"],
      "Resource": "arn:aws:ssm:us-east-2:851725603471:parameter/vibe/dev/tinyfish-api-key"
    },
    {
      "Sid": "EncryptProjectTinyFishParameterThroughSsm",
      "Effect": "Allow",
      "Action": ["kms:Encrypt", "kms:Decrypt", "kms:GenerateDataKey"],
      "Resource": "*",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.us-east-2.amazonaws.com", "kms:EncryptionContext:PARAMETER_ARN": "arn:aws:ssm:us-east-2:851725603471:parameter/vibe/dev/tinyfish-api-key" } }
    }
  ]
}
